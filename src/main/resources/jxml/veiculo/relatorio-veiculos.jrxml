<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="relatorio_veiculos" pageWidth="595" pageHeight="842" whenNoDataType="AllSectionsNoDetail" isSummaryWithPageHeaderAndFooter="true" columnWidth="523" leftMargin="36" rightMargin="36" topMargin="32" bottomMargin="20">
<style name="Institucional" isDefault="true" fontName="Maitree" fontSize="9"/>
	<parameter name="TITULO" class="java.lang.String"/>
	<parameter name="TOTAL" class="java.lang.Integer"/>
	<parameter name="BRASAO_DETRAN" class="java.io.InputStream"/>
	<parameter name="LOGO_ESTADO_CE" class="java.io.InputStream"/>
	<parameter name="RODAPE" class="java.io.InputStream"/>
	<queryString>
		<![CDATA[SELECT v.id::bigint AS id, v.placa, v.renavam, v.chassi, v.ano_fabricacao,
	       v.tipo::text AS tipo, v.id_proprietario::bigint AS id_proprietario, p.nome AS proprietario
FROM treino.veiculo v
JOIN treino.proprietario p ON p.id = v.id_proprietario
ORDER BY v.placa, v.id]]>
	</queryString>
	<field name="id" class="java.lang.Long"/>
	<field name="placa" class="java.lang.String"/>
	<field name="renavam" class="java.lang.String"/>
	<field name="chassi" class="java.lang.String"/>
	<field name="ano_fabricacao" class="java.lang.Integer"/>
	<field name="tipo" class="java.lang.String"/>
	<field name="id_proprietario" class="java.lang.Long"/>
	<field name="proprietario" class="java.lang.String"/>
	<group name="VeiculosPorPagina" isStartNewPage="true">
		<groupExpression><![CDATA["pagina-" + (($V{REPORT_COUNT}.intValue() - 1) / 15)]]></groupExpression>
	</group>
	<title><band height="150">
