 <textField pattern="dd/MM/yyyy HH:mm"><reportElement x="0" y="132" width="400" height="16" forecolor="#465564"/><textElement><font fontName="Kanit" size="9"/></textElement><textFieldExpression><![CDATA[new java.util.Date()]]></textFieldExpression></textField>
 </band></title>
