<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="relatorio_veiculo" pageWidth="595" pageHeight="842" whenNoDataType="AllSectionsNoDetail" isSummaryWithPageHeaderAndFooter="true" columnWidth="523" leftMargin="36" rightMargin="36" topMargin="32" bottomMargin="20">
<style name="Institucional" isDefault="true" fontName="Maitree" fontSize="9"/>
	<parameter name="TITULO" class="java.lang.String"/>
	<parameter name="BRASAO_DETRAN" class="java.io.InputStream"/>
	<parameter name="LOGO_ESTADO_CE" class="java.io.InputStream"/>
	<parameter name="RODAPE" class="java.io.InputStream"/>
	<queryString>
		<![CDATA[SELECT v.id::bigint AS id, v.placa, v.renavam, v.chassi, v.ano_fabricacao,
	       v.tipo::text AS tipo, v.id_proprietario::bigint AS id_proprietario, p.nome,
       p.cpf_cnpj AS "cpfCnpj", p.rua, p.numero, p.cep, p.cidade, p.estado, p.complemento
FROM treino.veiculo v
JOIN treino.proprietario p ON p.id = v.id_proprietario
ORDER BY v.placa, v.id]]>
	</queryString>
	<field name="id" class="java.lang.Long"/>
	<field name="placa" class="java.lang.String"/>
	<field name="renavam" class="java.lang.String"/>
	<field name="chassi" class="java.lang.String"/>
	<field name="ano_fabricacao" class="java.lang.Integer"/>
	<field name="tipo" class="java.lang.String"/>
	<field name="id_proprietario" class="java.lang.Long"/>
	<field name="nome" class="java.lang.String"/>
	<field name="cpfCnpj" class="java.lang.String"/>
	<field name="rua" class="java.lang.String"/>
	<field name="numero" class="java.lang.String"/>
	<field name="cep" class="java.lang.String"/>
	<field name="cidade" class="java.lang.String"/>
	<field name="estado" class="java.lang.String"/>
	<field name="complemento" class="java.lang.String"/>
	<field name="placaImagem" class="java.awt.Image"/>
	<title><band height="150">
 <image scaleImage="RetainShape"><reportElement x="30" y="24" width="51" height="58"/><imageExpression><![CDATA[$P{BRASAO_DETRAN}]]></imageExpression></image>
 <image scaleImage="RetainShape"><reportElement x="255" y="8" width="238" height="76"/><imageExpression><![CDATA[$P{LOGO_ESTADO_CE}]]></imageExpression></image>
 <textField><reportElement x="0" y="98" width="523" height="30" forecolor="#465564"/><textElement><font fontName="Kanit" size="20" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{TITULO}]]></textFieldExpression></textField>
 <textField pattern="dd/MM/yyyy HH:mm"><reportElement x="0" y="132" width="400" height="16" forecolor="#465564"/><textElement><font fontName="Kanit" size="9"/></textElement><textFieldExpression><![CDATA[new java.util.Date()]]></textFieldExpression></textField>
 </band></title>
	<detail><band height="550" splitType="Stretch"><image scaleImage="RetainShape" hAlign="Center" vAlign="Middle"><reportElement x="86" y="0" width="351" height="130"/><imageExpression><![CDATA[$F{placaImagem}]]></imageExpression></image><textField isBlankWhenNull="true" ><reportElement x="0" y="134" width="523" height="20"/><textElement><font fontName="Maitree" size="8" isBold="false"/></textElement><textFieldExpression><![CDATA[$F{placa}.contains("-") ? "Placa ilustrativa • Localidade do proprietário na tarjeta" : "Placa ilustrativa • QR ilustrativo"]]></textFieldExpression></textField><textField isBlankWhenNull="true" ><reportElement x="0" y="164" width="523" height="25"/><textElement><font fontName="Kanit" size="14" isBold="true"/></textElement><textFieldExpression><![CDATA["Veículo"]]></textFieldExpression></textField><textField isBlankWhenNull="true" ><reportElement x="0" y="197" width="523" height="22"/><textElement><font fontName="Maitree" size="10" isBold="false"/></textElement><textFieldExpression><![CDATA["Placa: " + $F{placa} + "     Tipo: " + $F{tipo} + "     Ano: " + $F{ano_fabricacao}]]></textFieldExpression></textField><textField isBlankWhenNull="true" ><reportElement x="0" y="224" width="523" height="22"/><textElement><font fontName="Maitree" size="10" isBold="false"/></textElement><textFieldExpression><![CDATA["RENAVAM: " + $F{renavam}]]></textFieldExpression></textField><textField isBlankWhenNull="true" ><reportElement x="0" y="251" width="523" height="22"/><textElement><font fontName="Maitree" size="10" isBold="false"/></textElement><textFieldExpression><![CDATA["CHASSI: " + $F{chassi}]]></textFieldExpression></textField><textField isBlankWhenNull="true" ><reportElement x="0" y="291" width="523" height="25"/><textElement><font fontName="Kanit" size="14" isBold="true"/></textElement><textFieldExpression><![CDATA["Proprietário"]]></textFieldExpression></textField><textField isBlankWhenNull="true" isStretchWithOverflow="true"><reportElement x="0" y="323" width="523" height="38"/><textElement><font fontName="Maitree" size="11" isBold="false"/></textElement><textFieldExpression><![CDATA[$F{nome}]]></textFieldExpression></textField><textField isBlankWhenNull="true" ><reportElement x="0" y="365" width="523" height="22"/><textElement><font fontName="Maitree" size="10" isBold="false"/></textElement><textFieldExpression><![CDATA["CPF / CNPJ: " + $F{cpfCnpj}]]></textFieldExpression></textField><textField isBlankWhenNull="true" ><reportElement x="0" y="400" width="523" height="25"/><textElement><font fontName="Kanit" size="13" isBold="true"/></textElement><textFieldExpression><![CDATA["Endereço"]]></textFieldExpression></textField><textField isBlankWhenNull="true" isStretchWithOverflow="true"><reportElement x="0" y="433" width="523" height="110"/><textElement><font fontName="Maitree" size="9" isBold="false"/></textElement><textFieldExpression><![CDATA[$F{rua} + ", Nº " + $F{numero} + "\n" + $F{complemento} + "\n" + $F{cidade} + " - " + $F{estado} + " • CEP: " + $F{cep}]]></textFieldExpression></textField></band></detail>
	<pageFooter><band height="50">
 <staticText><reportElement x="0" y="0" width="440" height="14" forecolor="#465564"/><textElement><font fontName="Kanit" size="8"/></textElement><text><![CDATA[DETRAN-CE • Sistema de treinamento • Consulta cadastral]]></text></staticText>
 <textField><reportElement x="440" y="0" width="83" height="14"/><textElement textAlignment="Right"><font fontName="Kanit" size="8"/></textElement><textFieldExpression><![CDATA["Página " + $V{PAGE_NUMBER}]]></textFieldExpression></textField>
 <image scaleImage="RetainShape"><reportElement x="-36" y="19" width="595" height="31"/><imageExpression><![CDATA[$P{RODAPE}]]></imageExpression></image>
 </band></pageFooter>
</jasperReport>
