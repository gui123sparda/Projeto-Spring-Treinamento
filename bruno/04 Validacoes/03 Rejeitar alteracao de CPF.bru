meta {
  name: Rejeitar alteracao de CPF
  type: http
  seq: 3
}

patch {
  url: {{baseUrl}}/api/proprietarios/{{proprietarioId}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {"cpfCnpj": "{{outroCpf}}"}
}

script:pre-request {
  bru.setVar("outroCpf", bru.getVar("cpf") === "52998224725" ? "11144477735" : "52998224725");
}

tests {
  test("Status HTTP 400", function () {
    expect(res.getStatus()).to.equal(400);
  });
  test("Erro no formato da API", function () {
    const body = res.getBody();
    expect(body.status).to.equal(res.getStatus());
    expect(body.mensagem).to.be.a("string").and.not.empty;
    expect(body.erros).to.be.an("array");
  });
}
