meta {
  name: Rejeitar tipo invalido
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/veiculos
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "tipo": "CAMINHAO",
    "idProprietario": {{proprietarioId}},
    "anoFabricacao": 2024,
    "chassi": "{{chassi}}",
    "renavam": "{{renavam}}",
    "placa": "{{placa}}"
  }
}

tests {
  test("Status HTTP 400", function () {
    expect(res.getStatus()).to.equal(400);
  });
  test("Erro no formato da API", function () {
    const body = res.getBody();
    expect(body.status).to.equal(res.getStatus());
    expect(body.mensagem).to.be.a("string").and.not.empty;
    expect(body.erros).to.be.an("array");
  });
}
