meta {
  name: Rejeitar CPF invalido
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/proprietarios
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {"cpfCnpj": "11111111111", "nome": "Teste Invalido"}
}

tests {
  test("Status HTTP 400", function () {
    expect(res.getStatus()).to.equal(400);
  });
  test("Erro no formato da API", function () {
    const body = res.getBody();
    expect(body.status).to.equal(res.getStatus());
    expect(body.mensagem).to.be.a("string").and.not.empty;
    expect(body.erros).to.be.an("array");
  });
}
