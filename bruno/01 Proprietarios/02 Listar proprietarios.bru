meta {
  name: Listar proprietarios
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/proprietarios
  body: none
  auth: none
}

tests {
  test("Status HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("Lista inclui o cadastro", function () {
    expect(res.getBody()).to.be.an("array");
    expect(res.getBody().some(item => item.id === bru.getVar("proprietarioId"))).to.equal(true);
  });
}
