meta {
  name: Buscar proprietario
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/proprietarios/{{proprietarioId}}
  body: none
  auth: none
}

tests {
  test("Status HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("ID do proprietario", function () {
    expect(res.getBody().id).to.equal(bru.getVar("proprietarioId"));
  });
}
