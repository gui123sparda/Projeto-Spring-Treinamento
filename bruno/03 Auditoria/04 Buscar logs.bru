meta {
  name: Buscar logs
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/log-proprietarios/{{logId}}
  body: none
  auth: none
}

tests {
  test("Status HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("ID da auditoria", function () {
    expect(res.getBody().id).to.equal(bru.getVar("logId"));
  });
}
