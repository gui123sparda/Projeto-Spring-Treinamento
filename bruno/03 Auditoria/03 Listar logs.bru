meta {
  name: Listar logs
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/log-proprietarios
  body: none
  auth: none
}

script:post-response {
  if (res.getStatus() === 200 && Array.isArray(res.getBody())) {
    const entry = res.getBody().find(item => item.idProprietario === bru.getVar("proprietarioId"));
    if (entry) bru.setVar("logId", entry.id);
  }
}

tests {
  test("Status HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("Auditoria gerada pelo banco", function () {
    expect(res.getBody()).to.be.an("array");
    expect(res.getBody().some(item => item.idProprietario === bru.getVar("proprietarioId"))).to.equal(true);
  });
}
