meta {
  name: Buscar veiculo
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/veiculos/{{veiculoId}}
  body: none
  auth: none
}

tests {
  test("Status HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("ID do veiculo", function () {
    expect(res.getBody().id).to.equal(bru.getVar("veiculoId"));
  });
}
